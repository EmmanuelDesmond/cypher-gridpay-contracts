{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": [
    "src/utils/**/*.ts",
    "src/components/splits/SplitAllocationEditor.tsx",
    "src/pages/merchant/SplitForwardConfigPage.tsx"
  ],
  "exclude": ["node_modules", "dist"]
}
